            <StoryText>
                <DefaultStyle Alignment="3" LineSpacing="12" FontSize="9"/>
                <Content FontSize="9" FontColor="Ink" Chars="Coverage and reliability come from 85 integration tests against a live Scribus, ABI-matched PyQt6 install for interactive mode, and per-tool error paths that surface as {ok: false, error: …} for the model to self-correct."/>
                <para Alignment="3" LineSpacing="12"/>
                <para Alignment="3" LineSpacing="12"/>
                <Content FontSize="9" FontColor="Ink" Chars="Documentation and UX are still maturing: the patterns library will keep growing."/>
