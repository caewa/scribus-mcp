# -*- coding: utf-8 -*-
## name = scribus-probe
## title = Scribus Python diagnostic

"""Dumps Scribus's embedded Python environment to a log file so we can see
exactly why PyQt6 (or PyQt5/PySide) isn't importable."""

import os, sys, json, traceback

LOG = os.path.join(os.environ.get("LOCALAPPDATA", os.path.expanduser("~")), "scribus-mcp", "probe.log")
try:
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
except OSError:
    pass

def log(s):
    try:
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(s + "\n")
    except Exception:
        pass


# Wipe any prior probe.log
try:
    if os.path.exists(LOG):
        os.remove(LOG)
except OSError:
    pass

log("=== Python ===")
log("version=" + sys.version.replace("\n", " "))
log("executable=" + str(sys.executable))
log("prefix=" + str(sys.prefix))
log("base_prefix=" + str(sys.base_prefix))
log("exec_prefix=" + str(sys.exec_prefix))
log("platform=" + sys.platform)

log("")
log("=== sys.path ===")
for p in sys.path:
    log("  " + repr(p))

log("")
log("=== env vars ===")
for k in ("PYTHONHOME", "PYTHONPATH", "PYTHONNOUSERSITE", "PYTHONSTARTUP"):
    log("  %s = %r" % (k, os.environ.get(k)))

log("")
log("=== site config ===")
try:
    import site
    log("  ENABLE_USER_SITE = %r" % getattr(site, "ENABLE_USER_SITE", None))
    log("  USER_BASE = %r" % getattr(site, "USER_BASE", None))
    log("  USER_SITE = %r" % getattr(site, "USER_SITE", None))
    log("  getsitepackages() = %r" % site.getsitepackages())
except Exception as exc:
    log("  site error: %s" % exc)

log("")
log("=== Qt binding probe ===")
for mod in ("PyQt6", "PyQt6.QtCore", "PyQt5", "PyQt5.QtCore", "PySide6", "PySide6.QtCore", "PySide2"):
    try:
        m = __import__(mod, fromlist=["__file__"])
        log("  OK %s -> %s" % (mod, getattr(m, "__file__", "?")))
    except Exception as exc:
        log("  FAIL %s -> %s: %s" % (mod, type(exc).__name__, exc))

log("")
log("=== expected install path ===")
expected = os.path.join(sys.prefix, "Lib", "site-packages", "PyQt6")
log("  exists(%s) = %s" % (expected, os.path.isdir(expected)))
if os.path.isdir(expected):
    try:
        log("  contents: " + ", ".join(sorted(os.listdir(expected))[:8]))
    except Exception:
        pass

# also list any PyQt6 dirs anywhere in known sys.path entries
log("")
log("=== PyQt6 search ===")
for p in sys.path:
    cand = os.path.join(p, "PyQt6")
    if os.path.isdir(cand):
        log("  FOUND " + cand)
